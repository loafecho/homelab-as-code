# NOT applied by Argo CD (the .example extension keeps it out of the sync). Create the per-namespace
# bootstrap Secret by hand, from your secrets manager, never from git:
#
#   kubectl -n apps create secret generic infisical-apps-bootstrap \
#     --from-literal=clientId="$CLIENT_ID" --from-literal=clientSecret="$CLIENT_SECRET"
#
# Equivalent manifest shape, for reference only:
apiVersion: v1
kind: Secret
metadata:
  name: infisical-apps-bootstrap
  namespace: apps
type: Opaque
stringData:
  clientId: "<machine-identity-client-id>"
  clientSecret: "<machine-identity-client-secret>"
