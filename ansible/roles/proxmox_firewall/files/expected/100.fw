# /etc/pve/firewall/100.fw  (control, zone=control)
# GENERATED — edit host_vars/control.yml, never this file.
[OPTIONS]
enable: 1
policy_in: DROP
policy_out: ACCEPT
# established/related replies auto-accepted by conntrack

[RULES]
IN ACCEPT -source 192.0.2.50 -p tcp -dport 22 # T1 break-glass SSH
IN ACCEPT -source 192.0.2.51 -p tcp -dport 22 # T1 break-glass SSH
IN ACCEPT -source 192.0.2.190 -p tcp -dport 443 # monitor canary probe (the one tag:monitor grant)
