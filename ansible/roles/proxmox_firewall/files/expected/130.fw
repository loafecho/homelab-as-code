IN ACCEPT -source 192.0.2.51 -p tcp -dport 9963 # cilium-operator metrics - no LAN client, management only
IN ACCEPT -source 192.0.2.100 -p tcp -dport 9963 # cilium-operator metrics - no LAN client, management only
IN ACCEPT -source 192.0.2.190 -p tcp -dport 9963 # cilium-operator metrics - no LAN client, management only
