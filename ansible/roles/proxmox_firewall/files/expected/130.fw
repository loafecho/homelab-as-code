IN ACCEPT -source 192.0.2.51 -p tcp -dport 9964 # cilium-envoy metrics - no LAN client, management only
IN ACCEPT -source 192.0.2.100 -p tcp -dport 9964 # cilium-envoy metrics - no LAN client, management only
