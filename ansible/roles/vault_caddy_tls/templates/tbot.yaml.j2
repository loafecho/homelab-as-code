{#- Rendered by roles/vault_caddy_tls. Staged to build/caddy/tbot.yaml for   -#}
{#- review by default; only copied to /etc/tbot/tbot.yaml on the live vault  -#}
{#- host when vault_caddy_tls_deploy: true (see README.md). No secret values -#}
{#- live here — the join token is provisioned out of band.                   -#}
version: v2
onboarding:
  join_method: token
  # Provisioned out of band from the secrets manager, never committed to git.
  token_file: /run/tbot/join-token
proxy_server: {{ teleport_proxy_addr }}
storage:
  type: directory
  path: /var/lib/tbot

outputs:
  # Repurposes Teleport's `database` output purely to mint + auto-renew a
  # `{{ teleport_ca_name }}`-CA leaf cert for Caddy's TLS listener. vault is
  # NOT a real Teleport-protected database and the Teleport auth/proxy is NOT
  # in the live secret-fetch data path — this is cert issuance/renewal only.
  # Requires a (non-functional) database resource named
  # `{{ teleport_db_resource_name }}` registered with `tctl` during the live
  # rollout so this output has a target CA to sign against.
  - type: database
    destination:
      type: directory
      path: {{ vault_caddy_tls_dir }}
    format: tls                     # plain tlscert.pem + key.pem + ca.pem, no db-client wrapping
    service: {{ teleport_db_resource_name }}

# On renewal, tbot rewrites the files in vault_caddy_tls_dir in place; Caddy
# does NOT need to be restarted to pick up a renewed cert on-disk (Caddy
# watches + reloads certs referenced by the `tls <cert> <key>` directive), but
# the systemd unit still wires a reload as a belt-and-suspenders hook — see
# roles/vault_caddy_tls/handlers/main.yml.
